# Copy this file to .env (same folder) and paste your real values below.
# .env is for local use only — never commit it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Display name shown in the app's topbar (no login, single-PM demo).
PM_NAME=Portfolio Manager

# Optional: Neo4j knowledge graph for product recommendation. If unset, the app
# falls back to the built-in rule-based recommender and works normally.
# Neo4j Aura: neo4j+s://<id>.databases.neo4j.io  |  local: bolt://localhost:7687
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
